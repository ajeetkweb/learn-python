   "source": [
    "# Find the count of given word in text file "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "3\n"
     ]
    }
   ],
   "source": [
    "counter = 0\n",
    "text = 'hello'\n",
    "with open(\"hello.txt\", 'r') as file:\n",
    "    content = file.read().lower()\n",
    "\n",
    "    for word in content.split():\n",
    "        if word == text:\n",
    "            counter += 1\n",
    "\n",
    "print(counter)"
   ]
  }
